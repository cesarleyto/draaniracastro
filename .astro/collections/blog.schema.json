{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "default": "Síntomas",
      "type": "string",
      "enum": [
        "Síntomas",
        "Diagnósticos",
        "Testimonios",
        "Vida Académica"
      ]
    },
    "image": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "excerpt",
    "pubDate"
  ]
}