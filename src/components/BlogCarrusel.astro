---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// 1. Buscamos los posteos y los ordenamos por fecha (el más nuevo primero)
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3); // Solo tomamos los primeros 3
---

<section class="pt-10 pb-24 bg-brand-red relative z-10">
  <div class="container mx-auto px-6 max-w-5xl">
    
    <div class="text-center mb-8">
      <h2 class="font-fredoka text-2xl md:text-3xl text-white font-bold">Últimas Publicaciones</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block space-y-3">
          <div class="aspect-[16/9] overflow-hidden rounded-xl shadow-md border border-white/20 bg-white/5">
            {post.data.image && (
              <Image 
                src={typeof post.data.image === 'string' ? post.data.image : post.data.image} 
                alt={post.data.title}
                width={600}
                height={400}
                class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
              />
            )}
          </div>

          <h3 class="font-fredoka text-base text-white/90 font-medium leading-snug group-hover:text-white transition-colors px-1">
            {post.data.title}
          </h3>
        </a>
      ))}
    </div>

    <div class="flex justify-center relative z-20 mt-4">
      <a 
        href="/blog" 
        class="relative inline-flex items-center justify-center px-8 py-2.5 overflow-hidden font-bold text-white rounded-full bg-gradient-to-r from-emerald-400 to-sky-400 hover:from-sky-400 hover:to-emerald-400 shadow-[0_4px_15px_rgba(52,211,153,0.4)] hover:shadow-[0_0_25px_rgba(56,189,248,0.7)] hover:-translate-y-0.5 transition-all duration-300 text-sm md:text-base"
      >
        <span class="relative">Más Entradas</span>
      </a>
    </div>

  </div>
</section>