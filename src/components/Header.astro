---
import IconLogo from "@/assets/logo/logo.svg";
import { MainMenu } from "@/data/menu";
import { socialMedia } from "@/data/config";
import MobileMenu from "@/components/MobileMenu.astro";

const rmTrailingSlash = (path: string): string => {
	return path.endsWith("/") && path.length > 1 ? path.slice(0, path.length - 1) : path;
};

const pathname = rmTrailingSlash(Astro.url.pathname);

// Separamos los enlaces normales del botón de llamado a la acción para reordenarlos
const normalMenuItems = MainMenu.filter(item => item.label !== "Agendar Cita");
const ctaMenuItem = MainMenu.find(item => item.label === "Agendar Cita");
---

<header id="main-header" class="sticky top-0 z-50 transition-all duration-300">
	<div id="header-bg" class="bg-white/90 backdrop-blur-md border-b border-transparent transition-all duration-300">
		<div id="header-container" class="container mx-auto px-6 py-4 flex items-center justify-between gap-x-4 transition-all duration-300">
			
			<!-- LOGO COMPUESTO: Icono + Tipografía -->
			<a href="/" class="flex gap-x-3 items-center group" aria-label="Dra. Anira Castro - Especialista en dolor de panza, reflujo, cólicos y salud digestiva infantil.">
				<span class="sr-only">
					Dra. Anira Castro, Gastroenteróloga Pediatra en CDMX. Tratamiento experto para dolor de panza, niños que no quieren comer, alergias (APLV), estreñimiento y reflujo infantil. Hospital Ángeles Pedregal y Roma Norte.
				</span>
				
				<!-- Contenedor del Icono SVG -->
				<div id="header-logo-icon" class="h-16 w-16 transition-all duration-300 flex-shrink-0 origin-left group-hover:scale-105">
					<IconLogo class="w-full h-full drop-shadow-sm" />
				</div>

				<!-- Contenedor Tipográfico -->
				<div id="header-logo-text" class="flex flex-col justify-center transition-all duration-300 origin-left">
					<span class="font-fredoka text-xl md:text-2xl text-brand-blue font-semibold tracking-wide leading-none mb-1">
						Dra. Anira Castro
					</span>
					<span class="font-nunito text-[9px] md:text-[10px] text-brand-red font-bold tracking-[0.15em] md:tracking-[0.2em] uppercase whitespace-nowrap hidden sm:block">
						Gastroenterología y Nutrición Pediátrica
					</span>
				</div>
			</a>

			<!-- NAVEGACIÓN DESKTOP -->
			<div class="hidden md:flex items-center gap-8">
				
				<nav>
					<ul class="flex items-center gap-6 font-fredoka text-lg tracking-wide font-semibold">
						{
							normalMenuItems.map((item) => (
								<li>
									<a
										href={item.href}
										class={`transition hover:-translate-y-0.5 inline-block ${item.hoverClass ?? ""} ${pathname === item.href ? (item.activeClass ?? "") : "text-brand-foreground/80"}`}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="flex items-center gap-5">
					<a href={socialMedia.facebook.url} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#1877F2] hover:scale-110 transition-all duration-300" aria-label="Facebook">
						<svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
						</svg>
					</a>
					<a href={socialMedia.instagram.url} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#E4405F] hover:scale-110 transition-all duration-300" aria-label="Instagram">
						<svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
						</svg>
					</a>
					<a href={socialMedia.tiktok.url} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-black hover:scale-110 transition-all duration-300" aria-label="TikTok">
						<svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.04-.1z" />
						</svg>
					</a>
				</div>

				{
					ctaMenuItem && (
						<div>
							<a
								href="/#contacto"
								class="relative inline-flex items-center justify-center px-6 py-2 overflow-hidden font-bold text-white rounded-full bg-gradient-to-r from-brand-red to-pink-500 hover:from-pink-500 hover:to-brand-red shadow-[0_4px_15px_rgba(225,29,72,0.4)] hover:shadow-[0_0_25px_rgba(225,29,72,0.7)] hover:-translate-y-0.5 transition-all duration-300"
							>
								<span class="relative">{ctaMenuItem.label}</span>
							</a>
						</div>
					)
				}

			</div>

			<button type="button" title="open mobile menu" command="show-modal" commandfor="mobile-menu" class="md:hidden text-brand-foreground hover:text-brand-blue transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
				</svg>
			</button>
		</div>
	</div>
	<MobileMenu />
</header>

<script>
	const bg = document.getElementById('header-bg');
	const container = document.getElementById('header-container');
	// Referenciamos las dos nuevas partes del logo
	const logoIcon = document.getElementById('header-logo-icon');
	const logoText = document.getElementById('header-logo-text');

	window.addEventListener('scroll', () => {
		if (window.scrollY > 20) {
			bg?.classList.add('shadow-md', 'border-slate-100');
			bg?.classList.remove('border-transparent');
			container?.classList.replace('py-4', 'py-2');
			
			// Encogemos el icono
			logoIcon?.classList.replace('h-16', 'h-10');
			logoIcon?.classList.replace('w-16', 'w-10');
			
			// Encogemos ligeramente la tipografía
			logoText?.classList.add('scale-90');
		} else {
			bg?.classList.remove('shadow-md', 'border-slate-100');
			bg?.classList.add('border-transparent');
			container?.classList.replace('py-2', 'py-4');
			
			// Restauramos el icono
			logoIcon?.classList.replace('h-10', 'h-16');
			logoIcon?.classList.replace('w-10', 'w-16');
			
			// Restauramos la tipografía
			logoText?.classList.remove('scale-90');
		}
	});
</script>