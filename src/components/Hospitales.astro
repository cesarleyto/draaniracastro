---
import { Image } from 'astro:assets';

// Importamos las fotos de las sedes
import imgPedregal from '@/assets/images/Pedregal.jpg';
import imgRomaNorte from '@/assets/images/RomaNorte.jpg';
---

<section class="relative w-full min-h-[75vh] flex items-center justify-center py-24 md:py-32 overflow-hidden z-10">
  
  <div class="absolute inset-0 z-0 bg-slate-900">
    <div class="absolute inset-0 animate-fade-bg-1 overflow-hidden">
      <Image 
        src={imgPedregal} 
        alt="Hospital Ángeles Pedregal" 
        class="w-full h-full object-cover animate-zoom-slow"
      />
    </div>
    <div class="absolute inset-0 animate-fade-bg-2 overflow-hidden">
      <Image 
        src={imgRomaNorte} 
        alt="Hospital Ángeles Clínica Londres Roma Norte" 
        class="w-full h-full object-cover animate-zoom-slow"
      />
    </div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900/90 z-10 mix-blend-multiply"></div>

  <div class="relative z-20 container mx-auto px-6 text-center mt-4">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <h2 class="font-fredoka text-3xl md:text-4xl text-white font-bold leading-tight drop-shadow-xl max-w-3xl mx-auto">
        Atención pediátrica de excelencia en <br class="hidden md:block" />
        <span class="text-brand-yellow">los mejores hospitales de la CDMX</span>
      </h2>

      <p class="font-nunito text-lg md:text-xl text-white/90 drop-shadow-md max-w-2xl mx-auto leading-relaxed">
        Instalaciones de primer nivel y tecnología de vanguardia para la salud de tu pequeño. Te esperamos en nuestras sedes exclusivas ubicadas en <strong>El Pedregal</strong> y la <strong>Roma Norte (Clínica Londres)</strong>.
      </p>

      <div class="pt-8 pb-12">
        <a 
          href="/#contacto" 
          class="relative inline-flex items-center justify-center px-10 py-4 overflow-hidden font-bold text-white rounded-full bg-gradient-to-r from-brand-red to-pink-500 hover:from-pink-500 hover:to-brand-red shadow-[0_4px_15px_rgba(225,29,72,0.4)] hover:shadow-[0_0_25px_rgba(225,29,72,0.7)] hover:-translate-y-0.5 transition-all duration-300 text-lg z-30"
        >
          <span class="relative">Agendar Cita</span>
        </a>
      </div>

    </div>
  </div>

</section>

<style>
  @keyframes fadeBgSlide {
    0%, 45% { opacity: 1; }
    50%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes zoomSlow {
    0% { transform: scale(1); }
    100% { transform: scale(1.15); }
  }

  .animate-fade-bg-1 { animation: fadeBgSlide 8s infinite; }
  .animate-fade-bg-2 { animation: fadeBgSlide 8s infinite 4s; opacity: 0; }
  .animate-zoom-slow { animation: zoomSlow 12s infinite alternate linear; }
</style>