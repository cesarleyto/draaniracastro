---
// No necesitamos importar imágenes externas aquí, usaremos mapas incrustados y un ícono SVG por código.
---

<section id="contacto" class="relative overflow-hidden py-24 bg-white">
  
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute top-0 right-1/4 size-[500px] rounded-full bg-brand-yellow opacity-10 blur-[120px]"></div>
    <div class="absolute bottom-10 left-10 size-[600px] rounded-full bg-brand-blue opacity-10 blur-[130px]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 max-w-5xl">
    
    <div class="text-center mb-16">
      <h2 class="font-fredoka text-3xl md:text-5xl text-brand-foreground font-bold leading-tight">
        Elige la ubicación <br class="hidden md:block" />
        <span class="text-brand-blue">más cercana a ti</span>
      </h2>
      <p class="font-nunito text-lg text-brand-foreground/70 mt-4 max-w-2xl mx-auto">
        Contamos con consultorios en dos de las zonas médicas más exclusivas de la CDMX para tu mayor comodidad.
      </p>
    </div>

    <div class="space-y-12">
      
      <div class="bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] overflow-hidden flex flex-col md:flex-row items-stretch border border-slate-100 transition-transform hover:-translate-y-1">
        
        <div class="w-full md:w-1/2 h-64 md:h-auto min-h-[300px] bg-slate-200">
          <iframe 
            src="https://maps.google.com/maps?q=Hospital%20Angeles%20Pedregal&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>

        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center space-y-4">
          <div class="inline-block bg-brand-yellow/20 text-yellow-700 font-bold text-xs px-3 py-1 rounded-full w-max mb-2 uppercase tracking-wide">
            Sede Sur
          </div>
          <h3 class="font-fredoka text-2xl md:text-3xl text-brand-foreground font-bold">
            Hospital Ángeles Pedregal
          </h3>
          <p class="font-nunito text-brand-foreground/80 leading-relaxed">
            Camino a Sta. Teresa 1055, Col. Héroes de Padierna, La Magdalena Contreras, C.P. 10700, CDMX.
          </p>
          
          <div class="pt-4 border-t border-slate-100">
            <p class="text-sm text-brand-foreground/60 mb-2 font-medium uppercase tracking-wider">Teléfono de citas (Recepción)</p>
            <a href="tel:5512469903" class="flex items-center gap-3 text-brand-blue hover:text-brand-red transition-colors group w-max">
              <div class="bg-brand-blue/10 p-3 rounded-full group-hover:bg-brand-red/10 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <span class="font-fredoka text-2xl font-bold">55 1246 9903</span>
            </a>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] overflow-hidden flex flex-col md:flex-row items-stretch border border-slate-100 transition-transform hover:-translate-y-1">
        
        <div class="w-full md:w-1/2 h-64 md:h-auto min-h-[300px] bg-slate-200">
          <iframe 
            src="https://maps.google.com/maps?q=Hospital%20Angeles%20Clinica%20Londres%20Roma&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>

        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center space-y-4">
          <div class="inline-block bg-brand-green/20 text-emerald-800 font-bold text-xs px-3 py-1 rounded-full w-max mb-2 uppercase tracking-wide">
            Sede Centro
          </div>
          <h3 class="font-fredoka text-2xl md:text-3xl text-brand-foreground font-bold">
            Hospital Ángeles Clínica Londres
          </h3>
          <p class="font-nunito text-brand-foreground/80 leading-relaxed">
            Calle Durango 50 / Frontera 74, Col. Roma Norte, Alcaldía Cuauhtémoc, C.P. 06700, CDMX.
          </p>
          
          <div class="pt-4 border-t border-slate-100">
            <p class="text-sm text-brand-foreground/60 mb-2 font-medium uppercase tracking-wider">Teléfono de citas (Recepción)</p>
            <a href="tel:5524007684" class="flex items-center gap-3 text-brand-blue hover:text-brand-red transition-colors group w-max">
              <div class="bg-brand-blue/10 p-3 rounded-full group-hover:bg-brand-red/10 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <span class="font-fredoka text-2xl font-bold">55 2400 7684</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>