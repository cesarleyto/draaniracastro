---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteName, siteLang, themeColor } from "@/data/config";
import type { LayoutProps as Props } from "@/types";

const { 
    title, 
    seoTitle = title, 
    seoDescription = "Dra. Anira Castro | Gastroenteróloga Pediatra en CDMX, Hospital Ángeles Pedregal (Sur) y Clínica Londres (Roma Norte / Condesa). Especialista en salud digestiva infantil, nutrición y motilidad gastrointestinal.", 
    noindex = false 
} = Astro.props;

// Usamos el dominio base para las imágenes de redes sociales
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.jpg", Astro.url.origin);
---

<!doctype html>
<html lang={siteLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={seoDescription} />
		<link rel="canonical" href={canonicalURL} />
		
		{noindex && <meta name="robots" content="noindex,nofollow" />}

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={siteName} />
		<link rel="manifest" href="/site.webmanifest" />

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${seoTitle} | ${siteName}`} />
		<meta property="og:description" content={seoDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLang} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${seoTitle} | ${siteName}`} />
		<meta name="twitter:description" content={seoDescription} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title} - Salud Digestiva para tu Hijo | Gastroenteróloga Pediátrica en CDMX, Roma Norte / Condesa y Pedregal (Sur CDMX)</title>

		<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
	</head>
	<body class="bg-white text-brand-foreground antialiased selection:bg-brand-blue selection:text-white">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />

		<script is:inline>
		  if (window.netlifyIdentity) {
		    window.netlifyIdentity.on("init", user => {
		      if (!user) {
		        window.netlifyIdentity.on("login", () => {
		          document.location.href = "/admin/";
		        });
		      }
		    });
		  }
		</script>
	</body>
</html>

<script>
	import "@tailwindplus/elements";
</script>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.getElementById("main-header");
		if (header) {
			const updateHeaderHeight = () => {
				document.documentElement.style.setProperty("--header-height", `${header.offsetHeight}px`);
			};
			updateHeaderHeight();
			window.addEventListener("resize", updateHeaderHeight);
		}
	});
</script>