---
import { getCollection, render } from "astro:content";
import { Image } from 'astro:assets'; 
import Layout from "@/layouts/Layout.astro";
import { categoryBgColor, categoryLabel, formatDate } from "@/utils/blogUtils";

// Importamos la foto de perfil (Asegúrate de que exista src/assets/images/profile.jpg)
import profileImg from '@/assets/images/profile.jpg';

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Agregamos "image" aquí para que sea súper fácil usarla abajo
const { title, excerpt, pubDate, category, image } = entry.data; 
---

<Layout title={`${title} - Dra. Anira Castro | Gastro Pediatra en Roma Norte / Condesa y Pedregal (Sur CDMX)`}>
	<section class="relative overflow-hidden py-16 md:py-24 bg-white">
		
		<div class="absolute inset-0 z-0 bg-white" aria-hidden="true">
			<div class="absolute top-0 right-1/4 size-[500px] rounded-full bg-brand-yellow opacity-10 blur-[120px]"></div>
			<div class="absolute bottom-10 left-10 size-[600px] rounded-full bg-brand-blue opacity-10 blur-[130px]"></div>
		</div>

		<div class="container mx-auto px-6 max-w-4xl relative z-10">
			
			<div class="max-w-3xl mx-auto">
				<a
					href="/blog"
					class="inline-flex items-center gap-1 text-sm text-brand-foreground/60 hover:text-brand-foreground mb-8 transition-colors font-nunito"
				>
					← Volver al blog
				</a>

				<div class="flex gap-4 mb-8">
					<div class={`w-2 shrink-0 rounded-full ${categoryBgColor(category)}`}></div>
					<div>
						<div class="flex items-center gap-3 mb-3">
							<span class="text-xs font-semibold bg-[#feca4f] rounded-full px-3 py-1 font-fredoka tracking-wide">
								{categoryLabel(category)}
							</span>
							<span class="text-sm text-brand-foreground/50 font-nunito">
								{formatDate(pubDate)}
							</span>
						</div>

						<h1 class="font-fredoka text-3xl lg:text-4xl text-brand-foreground font-bold leading-tight">
							{title}
						</h1>
					</div>
				</div>

				{image && (
					<img 
						src={typeof image === 'string' ? image : image.src} 
						alt={title} 
						class="w-full h-auto max-h-[450px] object-cover rounded-2xl mb-8 shadow-md" 
					/>
				)}

				{
					excerpt && (
						<p class="text-lg text-brand-foreground/70 font-nunito mb-8 leading-relaxed border-b border-slate-200 pb-8 italic">
							{excerpt}
						</p>
					)
				}

				<div class="prose prose-lg max-w-none font-nunito text-brand-foreground prose-headings:font-fredoka prose-a:text-brand-blue hover:prose-a:text-brand-red transition-colors">
					<Content />
				</div>

				<div class="flex justify-center my-14 relative z-20">
					<a 
						href="/#contacto" 
						class="relative inline-flex items-center justify-center px-12 py-4 overflow-hidden font-bold text-white rounded-full bg-gradient-to-r from-brand-red to-pink-500 hover:from-pink-500 hover:to-brand-red shadow-[0_4px_15px_rgba(225,29,72,0.4)] hover:shadow-[0_0_25px_rgba(225,29,72,0.7)] hover:-translate-y-0.5 transition-all duration-300 text-lg"
					>
						<span class="relative">Agendar Cita</span>
					</a>
				</div>

				<div class="bg-slate-50 rounded-3xl p-8 md:p-10 border border-slate-100 flex flex-col md:flex-row items-center md:items-start gap-8 shadow-inner">
					
					<div class="shrink-0">
						<Image 
							src={profileImg} 
							alt="Dra. Anira Lizbeth Castro Zárate" 
							class="size-28 rounded-full object-cover border-4 border-white shadow-md"
						/>
					</div>

					<div class="space-y-3 text-center md:text-left flex-1">
						<p class="text-xs font-semibold text-brand-blue uppercase tracking-widest font-fredoka">Artículo escrito y aprobado por:</p>
						
						<h3 class="font-fredoka text-2xl text-brand-foreground font-bold">Dra. Anira Lizbeth Castro Zárate</h3>
						
						<p class="font-nunito text-brand-foreground/80 text-sm leading-relaxed">
							Gastroenteróloga Pediátrica experta en Salud Digestiva Infantil y Neurogastroenterología. Comprometida con la salud y bienestar de tu familia.
						</p>
						
						<ul class="pt-2 space-y-1 text-xs text-brand-foreground/60 font-nunito bg-white/50 p-3 rounded-lg border border-slate-100">
							<li>• <strong>Céd. Especialista Gastroenterología Pediátrica:</strong> 14484942</li>
							<li>• <strong>Céd. Especialista Pediatría:</strong> 13122905</li>
							<li>• <strong>Alta Especialidad en Motilidad (Céd. C1):</strong> 8918391</li>
						</ul>
					</div>

				</div>
				</div>

		</div>
	</section>
</Layout>