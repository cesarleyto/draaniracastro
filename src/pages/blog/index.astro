---
import Layout from "@/layouts/Layout.astro";
import BlogList from "@/components/BlogList.astro";
---

<Layout title="Blog Médico - Dra. Anira Castro | Gastro Pediatra en Roma Norte / Condesa y Pedregal (Sur CDMX)">
	<section class="relative overflow-hidden py-16 md:py-24 bg-white">
		
		<div class="absolute inset-0 z-0 bg-white" aria-hidden="true">
			<div class="absolute -top-48 -left-48 size-[600px] rounded-full bg-brand-blue opacity-10 blur-[128px]"></div>
			<div class="absolute top-1/4 -right-24 size-[450px] rounded-full bg-brand-green opacity-10 blur-[110px]"></div>
		</div>

		<div class="container mx-auto px-6 max-w-5xl relative z-10">
			
			<div class="text-center mb-12 space-y-4">
				<h1 class="text-4xl md:text-5xl font-fredoka font-bold text-brand-foreground tracking-wide">
					Blog y Recomendaciones Médicas 🩺
				</h1>
				<p class="text-lg font-nunito text-brand-foreground/70">
					Artículos, consejos y noticias sobre la salud digestiva de tu pequeño.
				</p>
			</div>

			<BlogList />
			
		</div>
	</section>
</Layout>